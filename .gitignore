# Environment files. Ignore every local env file, including nested ones,
# but keep tracked examples with placeholders.
.env
.env.*
!.env.example
!.env.*.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Node
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Local backup dumps. Never commit these; they have contained secrets.
artifacts/

.worktrees/
.security-key
logs/security/
